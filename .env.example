# Copy to .env and change what you need.
# Port of the database on your laptop (change it if 15432 is taken).
PG_PORT=15432

# Your LLM: a free Gemini key from https://aistudio.google.com ...
# GOOGLE_API_KEY=your-key
# ... or a local model through Ollama (run: ollama pull qwen3:4b)
# WATCHDOG_MODEL=ollama_chat/qwen3:4b
